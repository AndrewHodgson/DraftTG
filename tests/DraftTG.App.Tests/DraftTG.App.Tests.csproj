<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(DraftTGPortableBuild)' != 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(DraftTGPortableBuild)' != 'true'">10.0.18362.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DraftTG.App/DraftTG.App.csproj" />
    <ProjectReference Include="../../src/DraftTG.Application/DraftTG.Application.csproj" />
    <ProjectReference Include="../../src/DraftTG.ArenaIntegration/DraftTG.ArenaIntegration.csproj" />
    <ProjectReference Include="../../src/DraftTG.Data/DraftTG.Data.csproj" />
    <ProjectReference Include="../../src/DraftTG.Domain/DraftTG.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <EmbeddedResource Include="../../src/DraftTG.App/CardOverlayWindow.axaml" LogicalName="CardOverlayWindow.axaml" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../Fixtures/arena-artwork-live/**/*" Link="Fixtures/arena-artwork-live/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/arena-wgc-p1p7/**/*" Link="Fixtures/arena-wgc-p1p7/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/17lands-api-card-data.json" Link="Fixtures/17lands-api-card-data.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/arena-woe-p1p6-visual-placement.json" Link="Fixtures/arena-woe-p1p6-visual-placement.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/premier-fra-course-snapshot-live.jsonl" Link="Fixtures/premier-fra-course-snapshot-live.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/premier-fra-course-cards.json" Link="Fixtures/premier-fra-course-cards.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/deckselect-woe-completion-live.jsonl" Link="Fixtures/deckselect-woe-completion-live.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/deckselect-woe-cards.json" Link="Fixtures/deckselect-woe-cards.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/SyntheticArenaDatabase.cs" Link="Shared/SyntheticArenaDatabase.cs" />
    <None Include="../Fixtures/arena-card-database-fra-identity.sql" Link="Fixtures/arena-card-database-fra-identity.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/arena-card-database-synthetic.sql" Link="Fixtures/arena-card-database-synthetic.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
